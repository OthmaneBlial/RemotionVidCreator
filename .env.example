# Optional Z.ai script generation
# Without this key, the app uses its local template/demo fallback.
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/api/anthropic
ZAI_MODEL=claude-sonnet-4-20250514

# Optional Unsplash image search. The runtime only reads the access key.
# Create an application at: https://unsplash.com/developers
UNSPLASH_APPLICATION_ID=your_application_id_here
UNSPLASH_ACCESS_KEY=your_access_key_here
# Keep this server-side. The current runtime does not read it.
UNSPLASH_SECRET_KEY=your_secret_key_here
UNSPLASH_UTM_SOURCE=remotion-ai-video-generator
