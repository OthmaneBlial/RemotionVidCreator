# Anthropic API Key for Claude AI script generation
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Unsplash API credentials (keep the secret key server-side only)
# Create an application at: https://unsplash.com/developers
UNSPLASH_APPLICATION_ID=your_application_id_here
UNSPLASH_ACCESS_KEY=your_access_key_here
UNSPLASH_SECRET_KEY=your_secret_key_here
UNSPLASH_UTM_SOURCE=remotion-ai-video-generator
